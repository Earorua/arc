ARC_ENVIRONMENT=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ARC_ADMIN_EMAILS=
ARC_AI_ENABLED=false
ARC_AI_USER_DAILY_QUOTA=3
ARC_AI_GLOBAL_DAILY_BUDGET_UNITS=100
ARC_AI_RATE_LIMIT_PER_MINUTE=2
ARC_AI_RESEARCH_ENABLED=false
# Omit ARC_AI_RESEARCH_EXECUTOR for synchronous execution; use cloudflare-workflow-v1 only with the fixed remote Kimi policy.
# ARC_AI_RESEARCH_EXECUTOR=cloudflare-workflow-v1
# Executor-only: unset or exact true preserves scheduled maintenance and existing-job bootstrap.
# Set false only after draining all outstanding work; status and Workflow final delivery remain available.
# ARC_RESEARCH_EXECUTOR_MAINTENANCE_ENABLED=true
# Bridge origins are independent canonical HTTPS roots. Key IDs use 1-32 ASCII letters, digits, underscores, or hyphens.
# ARC_AI_RESEARCH_EXECUTOR_URL=https://executor.example
# ARC_AI_RESEARCH_SITE_TO_EXECUTOR_KEY_ID=site-to-executor-v1
# Generate an independent 32-byte secret as exactly 64 lowercase hexadecimal characters.
# ARC_AI_RESEARCH_SITE_TO_EXECUTOR_SECRET_HEX=
# ARC_AI_RESEARCH_EXECUTOR_TO_SITE_KEY_ID=executor-to-site-v1
# Generate a different independent 32-byte secret as exactly 64 lowercase hexadecimal characters.
# ARC_AI_RESEARCH_EXECUTOR_TO_SITE_SECRET_HEX=
# Optional ARC_AI_RESEARCH_PROFILE=kimi-low-output32k-v3 requires moonshotai/kimi-k3, Research timeout1200000, Repair budget0, and Research reservation<=5000000; omit for legacy behavior.
ARC_AI_MODEL_RESEARCH=
ARC_AI_MODEL_ECONOMY=
ARC_AI_SITE_DAILY_BUDGET_MICROS=0
ARC_AI_SITE_MONTHLY_BUDGET_MICROS=0
ARC_AI_RESEARCH_MAX_COST_MICROS=0
ARC_AI_REPAIR_MAX_COST_MICROS=0
ARC_AI_RESEARCH_TIMEOUT_MS=20000
ARC_AI_REPAIR_TIMEOUT_MS=10000
ARC_AI_RESEARCH_CACHE_DAYS=14
ARC_AI_IP_HASH_SALT=
# In the completed remote executor integration, only the executor receives OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
